{
  "name": "aws-student-hub",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,ts,tsx,css}\" \"backend/**/*.{js,ts}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,ts,tsx,css}\" \"backend/**/*.{js,ts}\" --ignore-path .prettierignore",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.3"
  }
}
