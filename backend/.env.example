# Runtime
NODE_ENV=development
PORT=5001
LOG_LEVEL=info
LOG_PRETTY=true
CORS_ORIGIN=http://localhost:5173

# Persistence and application signing
MONGODB_URI=mongodb+srv://username:password@example.mongodb.net/aws-student-hub
JWT_SECRET=replace-with-a-long-random-secret
CHALLENGE_SIGNING_SECRET=replace-with-a-separate-long-random-secret
AWS_CRED_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key

# Auth0 identity verification for Google sign-in
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id

# Event and challenge storage
S3_REGION=us-east-1
S3_BUCKET_NAME=replace-with-upload-bucket
AWS_HUB_EVENT_THUMBNAILS=replace-with-thumbnail-prefix
AWS_ADMIN_ACCESS_KEY_ID=replace-with-local-development-key
AWS_ADMIN_SECRET_ACCESS_KEY=replace-with-local-development-secret
AWS_S3_BUCKET=replace-with-student-workspace-bucket
AWS_CHALLENGE_BUCKET=replace-with-challenge-bucket

# Email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=STARTTLS
SMTP_USER=replace-with-sender-email
SMTP_PASS=replace-with-provider-app-password

# Discord integration
DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_GUILD_ID=replace-with-guild-id
DISCORD_CHANNEL_ID=replace-with-channel-id

# Optional legacy single-classroom Prizeversity fallback
PRIZEVERSITY_API_URL=https://www.prizeversity.com
PRIZEVERSITY_API_KEY=
PRIZEVERSITY_CLASSROOM_ID=

# Optional legacy bootstrap token
ADMIN_TOKEN=
