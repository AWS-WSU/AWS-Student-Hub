{
  "name": "aws-student-hub-backend",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "Backend for AWS Student Hub",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"error: no test specified.\" && exit 1",
    "lint": "eslint .",
    "rebuild-sharp-lambda": "bun install --force --os=linux --cpu=x64",
    "cleanup-aws": "tsx scripts/cleanup-aws-credentials.ts",
    "create-superuser": "tsx scripts/createSuperuser.ts",
    "seed-aws-cyber-challenge": "tsx scripts/seedAwsCyberChallenge.ts",
    "seed-robots-trap-challenge": "tsx scripts/challenges/seedRobotsTrapChallenge.ts"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1050.0",
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/lib-storage": "^3.500.0",
    "axios": "^1.15.2",
    "bad-words": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "leo-profanity": "^1.7.0",
    "mongoose": "^7.8.9",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "serverless-http": "^3.2.0",
    "sharp": "^0.33.0",
    "uuid": "^14.0.0",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.149",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.25",
    "@types/nodemailer": "^7.0.4",
    "@types/validator": "^13.15.10",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
